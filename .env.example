# Copy to .env and fill in. .env is gitignored - never commit it.
# Only variables the stack actually reads are listed here.

# --- Odoo ---
ODOO_USER=
ODOO_PASSWORD=

# --- Twilio WhatsApp ---
# Account SID only. The Auth Token is NOT stored here: enter it in the n8n "Basic Auth" credential.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Public URL ---
# Bare hostname (no https://, no trailing slash) that Twilio uses to fetch invoice PDFs.
# Must route to n8n through the tunnel - see cloudflared/config.example.yml.
PUBLIC_BASE_URL=hooks.example.com

# --- Signed PDF links ---
# 64 hex characters. Signs the links in the main workflow and verifies them in "Serve Invoice PDFs".
# Generate:  openssl rand -hex 32    (PowerShell alternative: see QUICKSTART.md)
PDF_LINK_SECRET=

# --- n8n's database login (local-dev defaults; must match POSTGRES_USER / POSTGRES_PASSWORD in docker-compose.yml) ---
N8N_DB_POSTGRESDB_USER=odoo
N8N_DB_POSTGRESDB_PASSWORD=odoopass123

# --- Meta Cloud API (only the webhook-verification workflow uses these; sending still goes through Twilio) ---
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=

# --- Optional ---
N8N_LOG_LEVEL=info
