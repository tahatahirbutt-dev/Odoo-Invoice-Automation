            {
              "id": "7808dfc9-eed1-49ca-a32d-425ef836a1db",
              "leftValue": "={{ $json.phone_e164 }}",
              "rightValue": "is not empty",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
