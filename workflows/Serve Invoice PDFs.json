{
  "name": "Serve Invoice PDFs",
  "nodes": [
    {
      "parameters": {
        "path": "invoice-pdf",
        "responseMode": "responseNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        0
      ],
      "id": "2147e5fa-30f6-4c45-a6bf-4d993e3c6749",
      "name": "Webhook",
      "webhookId": "a2cebd6f-d150-427f-8854-128f3037cd12"
    },
    {
      "parameters": {
        "action": "hmac",
        "type": "SHA256",
        "value": "={{ $json.query.invoice_id }}.{{ $json.query.exp }}",
        "dataPropertyName": "expected_token",
        "secret": "={{ $env.PDF_LINK_SECRET }}",
        "encoding": "hex"
      },
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 1,
      "position": [
        208,
        0
      ],
      "id": "2e7390a5-e270-4f47-8602-3fb81778bf0b",
      "name": "Compute Expected Token"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 3
          },
          "conditions": [
            {
              "id": "630eb610-bb5d-457e-b4d9-4a6f08b66ade",
              "leftValue": "={{ $json.query.invoice_id }}",
              "rightValue": "^\\d{1,9}$",
              "operator": {
                "type": "string",
                "operation": "regex"
              }
            },
            {
              "id": "81f9731a-a269-4dca-953b-1c192d698fab",
              "leftValue": "={{ Number($json.query.exp) }}",
              "rightValue": "={{ Math.floor(Date.now() / 1000) }}",
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            },
            {
              "id": "4dd96430-6104-49f7-909a-775d70ae0c9f",
              "leftValue": "={{ $json.query.token }}",
              "rightValue": "={{ $json.expected_token }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        416,
        0
      ],
      "id": "a94a6a2f-2db8-4e52-bd20-264f5740c814",
      "name": "Link Valid?"
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "Forbidden",
        "options": {
          "responseCode": 403
        }
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        624,
        192
      ],
      "id": "4a164c40-eca9-4648-9a7b-dbe26d1f1712",
      "name": "Reject 403"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://odoo:8069/web/session/authenticate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"call\",\n  \"params\": {\n    \"db\": \"odoo\",\n    \"login\": \"{{$env.ODOO_USER}}\",\n    \"password\": \"{{$env.ODOO_PASSWORD}}\"\n  }\n}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        624,
        -96
      ],
      "id": "8c0e17e9-c744-46c4-9160-62c013f3803b",
      "name": "Get Odoo Session"
