        "assignments": {
          "assignments": [
            {
              "id": "877277db-0eef-4a84-8245-278e9a8d677c",
              "name": "session_cookie",
              "value": "={{$json.headers['set-cookie'][0].split(';')[0]}}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        832,
        -96
      ],
      "id": "656bc949-0329-4776-b4d8-2927961264ff",
      "name": "Extract Session ID"
    },
    {
      "parameters": {
        "url": "=http://odoo:8069/report/pdf/account.report_invoice_with_payments/{{ $('Webhook').item.json.query.invoice_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Cookie",
