{
  "name": "odoo-invoice-automation",
  "version": "1.1.0",
  "description": "Automated invoice PDF delivery via WhatsApp using Odoo ERP, n8n and Twilio",
  "author": "Taha Tahir Butt",
  "license": "MIT",
  "keywords": ["odoo", "n8n", "automation", "invoice", "whatsapp", "erp", "workflow", "twilio"],
  "repository": {
    "type": "git",
    "url": "https://github.com/tahatahirbutt-dev/Odoo-Invoice-Automation.git"
  },
  "scripts": {
    "dev": "docker compose up",
    "dev:detach": "docker compose up -d",
    "stop": "docker compose down",
    "logs": "docker compose logs -f n8n",
    "logs:odoo": "docker compose logs -f odoo",
    "logs:all": "docker compose logs -f",
    "clean": "docker compose down -v",
    "restart": "docker compose restart n8n",
    "test": "python3 scripts/lint_workflows.py"
  },
  "dependencies": {}
}
